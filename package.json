{
       "name": "@geeko/hyper",
       "version": "0.0.1",
       "description": "HTTP server for Geeko systems + general static file server",
       "main": "./dist/geeko-hyper.js",
       "scripts": {
              "dev": "tsc -w",
              "build": "node ./scripts/build/ -n geeko-hyper -t ncc -o dist/ -e production",
              "pub": "npm run app:build && npm publish --access=public",
              "test": "node --test",
              "link": "npm --local unlink @geeko/hyper && npm --local link @geeko/cli",
              "app:build": "node ./scripts/build/ -n geeko-hyper -t ncc -o dist/ -e production"
       },
       "keywords": [
              "CLI"
       ],
       "author": "Metwas",
       "license": "MIT",
       "repository": {
              "url": "https://github.com/Metwas/geeko-hyper"
       },
       "devDependencies": {
              "@types/node": "^24.3.0"
       },
       "dependencies": {
              "@geeko/configuration": "^0.1.3",
              "@geeko/core": "^1.0.0",
              "@geeko/log": "^1.1.0",
              "@geeko/net": "^0.3.2",
              "@geeko/os": "^1.1.0",
              "@geeko/serialization": "^1.2.0",
              "@geeko/tasks": "^1.1.0",
              "hyper-express": "^6.17.3",
              "tseep": "^1.3.1"
       }
}
